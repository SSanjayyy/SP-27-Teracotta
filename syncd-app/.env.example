# Copy this file to .env (same folder) and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# Use the PUBLISHABLE key (starts with sb_publishable_…) or the legacy "anon" key.
# NEVER put the secret / service_role key here — EXPO_PUBLIC_ values ship inside the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Spotify app Client ID (Spotify Developer Dashboard -> your app -> Settings). The Client ID is
# public, so it's fine here. NEVER put the Client Secret in this file; it lives in Supabase
# secrets (see SETUP.md, "Edge functions & Spotify").
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Demo mode: true = fictional demo songs instead of Spotify (and, if the Supabase keys above are
# empty, a pet that lives on the phone only). Leave false for real use.
EXPO_PUBLIC_DEMO_MODE=false
