# Copy this file to .env (same folder) and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# Use the PUBLISHABLE key (starts with sb_publishable_…) or the legacy "anon" key.
# NEVER put the secret / service_role key here — EXPO_PUBLIC_ values ship inside the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
